# Admin opens directly on localhost. Add trusted hosts only behind a private network or access gateway.
ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost,::1
ENHANCE_API_KEY=replace-with-a-separate-long-random-key
# Requests per minute shared by everything using ENHANCE_API_KEY. Positive integer; defaults to 60.
ENHANCE_RATE_LIMIT_PER_MIN=60

# Active candidate routes; each model row binds to one of these server-side keys.
DASHSCOPE_API_KEY=
APIYI_API_KEY=
BANANA_ROUTER_API_KEY=
RUNNINGHUB_API_KEY=

# Independent pre/post text review. Defaults to qwen-flash and fails closed if unavailable.
CONTENT_REVIEW_MODEL_ID=qwen-flash

# Optional direct-provider routes for future model configurations (OpenAI/Gemini official keys are prohibited without explicit approval).
DEEPSEEK_API_KEY=

# Persistent writable directory. Back up this directory with the application.
DATA_DIR=./data
# Set this behind a reverse proxy to enforce same-origin admin writes.
APP_ORIGIN=http://127.0.0.1:6770

# Content review (Decisions via LoopRouter). mock = fixed demo samples only; live requires the key.
REVIEW_PROVIDER_MODE=mock
LOOPROUTER_API_KEY=
REVIEW_DECISIONS_MODEL=gpt-6-luna
REVIEW_TIMEOUT_MS=20000
REVIEW_MAX_UPLOAD_MB=10
REVIEW_MAX_IMAGE_PIXELS=25000000

# 腾讯云数据万象 CI 内容审核配置（统一支持文本同步审核 + 图片批量同步审核）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_CI_BUCKET=your-bucket-appid
TENCENT_CI_REGION=ap-nanjing
TENCENT_CI_TEXT_BIZ_TYPE=
TENCENT_CI_IMAGE_BIZ_TYPE=
